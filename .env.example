# PrecisionFlow — The Entrepreneur's Toolbox
# Copy this file to .env and fill in your keys.

# --- LLM (Gemini at Temperature 0.1) ---
GEMINI_API_KEY=AIza...
LLM_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.1

# --- Supabase (PostgreSQL + pgvector) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# --- External APIs ---
GOOGLE_TRENDS_API_KEY=
SEMRUSH_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=

# --- Quality Gates ---
CRITIC_PASS_THRESHOLD=0.80
MAX_CRITIC_RETRIES=3

# --- Server ---
HOST=0.0.0.0
PORT=8000
